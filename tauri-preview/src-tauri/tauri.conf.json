{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ukikura",
  "version": "1.0.6",
  "identifier": "com.ukikura.dynamicisland",
  "build": {
    "frontendDist": "../../dynamic-island/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ukikura Dynamic Island",
        "label": "main",
        "width": 800,
        "height": 400,
        "x": null,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/ukikura-logo.ico"
    ]
  }
}
